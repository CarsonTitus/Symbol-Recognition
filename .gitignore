# ---------------------------------------------------------------------------
# What this does: tells git which files NEVER to commit.
# Why: datasets, model weights and secrets are large or private (CLAUDE.md §0, §9).
# ---------------------------------------------------------------------------

# Python virtual environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Data: everything under data/ except the two markdown files that describe it
data/*
!data/README.md
!data/SOURCES.md
!data/metadata_template.csv

# Training runs, exported models and weights
runs/
exports/
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.onnx

# Secrets: Kaggle API token (never commit it)
kaggle.json
.env

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Phone-model export environment (needs an older PyTorch; see README)
.venv-export/

# Android build output and machine-specific settings
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
# Model files are copied in by scripts/export_tflite.py --android (not committed)
android/app/src/main/assets/
